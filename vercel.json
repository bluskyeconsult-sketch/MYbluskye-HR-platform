{
  "crons": [
    {
      "path": "/api/cron/fetch-jobs",
      "schedule": "0 2 * * *"
    }
  ],
  "functions": {
    "api/ai/*.js": {
      "maxDuration": 30
    },
    "api/*.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
