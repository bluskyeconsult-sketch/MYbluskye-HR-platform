# Environment Variables Reference
# Confirmed real and required based on direct code review throughout
# this engagement. This file was missing from the project entirely -
# built now as genuinely useful documentation, not a guess.

# ============================================
# Supabase - Frontend (safe to expose, Vite-prefixed by design)
# ============================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ============================================
# Supabase - Backend only (server-side, NEVER prefix with VITE_)
# ============================================
# CRITICAL: confirmed via direct code review that index.js falls back
# to the anon key if this is missing, which can cause admin-gated
# actions to fail with a false "Admin access required" error even for
# genuine admins - profile lookups run under RLS instead of bypassing
# it. Worth directly confirming this is actually set in Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# OpenAI - Backend only
# ============================================
# CONFIRMED: index.js reads this correctly. A second variable name,
# VITE_OPENAI_API_KEY, is also read as a fallback in several backend
# functions - this is safe ONLY because it's read via process.env in
# backend code, never via import.meta.env in frontend code. Two
# confirmed, real security vulnerabilities were found and fixed this
# session (SystemHealthDashboard.jsx, aiVirtualAssistantService.js)
# where frontend files read this exact variable name via
# import.meta.env, which would expose the real key in the browser
# bundle. If you see this pattern in any other frontend file, treat it
# as critical and fix immediately - do not assume it's safe just
# because it worked elsewhere.
OPENAI_API_KEY=

# ============================================
# Email (Hostinger SMTP) - Backend only
# ============================================
EMAIL_USER=
EMAIL_PASSWORD=
# VITE_EMAIL_USER is also read as a backend fallback - same safety
# note as OPENAI_API_KEY above applies.

# ============================================
# Stripe - Backend only
# ============================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================
# Frontend Stripe (safe to expose, Vite-prefixed by design)
# ============================================
VITE_STRIPE_PUBLISHABLE_KEY=
